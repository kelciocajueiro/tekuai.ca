{% set footer = i18n[lang.code].footer %}

<footer class="site-footer mt-8">
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="font-heading flex gap-0 text-[1.5rem] font-bold text-white">
        <span>TEKU</span>
        <span class="text-accent-cyan">.AI</span>
      </div>

      <p>{{ "footer.description" | t }}</p>

      <p></p>

      <div class="footer-socials">
        {% for social in footer.socials %}
          <a href="{{ "social.url" | t }}" class="social-icon" aria-label="{{ social.label }}">
            <i class="{{ social.icon }}"></i>
          </a>
        {% endfor %}
      </div>
    </div>

    <div>
      <h4 class="footer-heading">Solutions</h4>
      <ul class="footer-links">
        {% for item in footer.solutions %}
          <li><a href="{{ item.url }}" class="footer-link">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h4 class="footer-heading">Company</h4>
      <ul class="footer-links">
        {% for item in footer.company %}
          <li><a href="{{ item.url }}" class="footer-link">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </div>

    <div>
      <h4 class="footer-heading">Stay Updated</h4>
      <p class="text-font mb-2 text-[0.9rem]">Get the latest AI automation tips straight to your inbox.</p>

      <form class="newsletter-form" onsubmit="event.preventDefault()">
        <input type="email" class="glass-input" placeholder="Enter your email" required />
        <button type="submit" class="btn btn-primary btn-sm px-4 py-2.5">
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="copyright">
      &copy; {{ year | default(2026) }} {{ site.name | default("Teku AI") }}. All rights reserved.
    </div>
  </div>
</footer>
