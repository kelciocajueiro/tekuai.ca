<section class="hero-section">
  <div class="grid-background"></div>
  <div class="hero-container">
    <h1>
      {{ "hero.title" | t }}
      <br />
      <span class="gradient-text">{{ "hero.subtitle" | t }}</span>
    </h1>

    <p class="hero-description">{{ "hero.description" | t }}</p>

    <div class="hero-actions">
      {% set cta = i18n[lang.code].cta %}
      <a href="{{ cta.link }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        {{ "quote.label" | t }}
      </a>
      <a href="#how-it-works" class="btn btn-secondary">{{ "hero.learn" | t }}</a>
    </div>
  </div>
</section>
