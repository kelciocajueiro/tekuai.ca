<div
  class="floating-lang-switcher"
  :class="{ 'is-visible': visible }"
  x-data="{
    ...langSwitcher('{{ lang.code }}', '{{ page.url }}', '{{ site.baseUrl }}'),
    visible: false,
    init() {
      setTimeout(() => this.visible = true, 200)
    }
  }">
  <button
    class="lang-toggle-btn"
    @click="switchLang()"
    :title="lang === 'en' ? 'Switch to Portuguese' : 'Mudar para Inglês'">
    <img
      :src="flag"
      :key="lang"
      class="flag-png"
      x-transition:enter="flag-enter"
      x-transition:enter-start="flag-enter-start"
      x-transition:enter-end="flag-enter-end"
      x-transition:leave="flag-leave"
      x-transition:leave-start="flag-leave-start"
      x-transition:leave-end="flag-leave-end" />
  </button>
</div>

<script>
  function langSwitcher(currentLang, currentUrl, baseUrl) {
    const normalizedBase = baseUrl.replace(/\/$/, '');

    return {
      lang: currentLang,

      get flag() {
        return `${normalizedBase}/assets/icons/flags/${this.lang}.png`;
      },

      switchLang() {
        const newLang = this.lang === 'en' ? 'pt' : 'en';

        let newPath = currentUrl;

        if (newPath.startsWith('/en/')) {
          newPath = newPath.replace('/en/', `/${newLang}/`);
        } else if (newPath.startsWith('/pt/')) {
          newPath = newPath.replace('/pt/', `/${newLang}/`);
        } else if (newPath === '/en' || newPath === '/pt') {
          newPath = `/${newLang}/`;
        }

        window.location.href = `${normalizedBase}${newPath}`;
      },
    };
  }
</script>
