---
layout: layouts/base.njk

pagination:
  data: languages
  size: 1
  alias: lang

permalink: '/{{ lang.code }}/'
---

{% include "components/lang-switcher.njk" %}
{% include "components/hero.njk" %}
<div class="divider-fade"></div>

<section id="work" class="section">
  <h2 class="section-title">{{ "sections.projects" | t }}</h2>
  <div class="mx-auto">{% include "components/videos.njk" %}</div>
</section>

<div class="divider-fade"></div>

<section id="services" class="section">
  <h2 class="section-title">{{ "sections.solutions" | t }}</h2>
  {% include "components/service-card.njk" %}
</section>

<div class="divider-fade"></div>

<section id="tools" class="section">
  <h2 class="section-title">{{ "sections.tools" | t }}</h2>
  <div class="mx-auto">{% include "components/tools.njk" %}</div>
</section>

{% include "components/cta.njk" %}

<section id="faq" class="section">
  <h2 class="section-title">{{ "sections.questions" | t }}</h2>
  <div class="mx-auto mt-16 max-w-3xl">{% include "components/accordion.njk" %}</div>
</section>

{% include "components/footer.njk" %}
